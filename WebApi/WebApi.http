@baseUrl = http://localhost:5151
@adminEmail = admin@app.pl
@adminPassword = Admin@123!

### ── 1. Logowanie — skopiuj accessToken do zmiennej @token poniżej ──────────
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### ── Wklej token z odpowiedzi powyżej ───────────────────────────────────────
@token = WKLEJ_TOKEN_TUTAJ

### ── 2. Dane zalogowanego użytkownika ───────────────────────────────────────
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### ── 3. Pobranie listy bramek (paginacja) ───────────────────────────────────
GET {{baseUrl}}/api/gates?page=1&size=10
Authorization: Bearer {{token}}
Accept: application/json

### ── 4. Dodanie bramki ───────────────────────────────────────────────────────
POST {{baseUrl}}/api/gates
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bramka A",
  "type": "Entry",
  "location": "Wejście główne"
}

### ── 5. Pobranie bramki po ID (wklej ID z odpowiedzi żądania nr 4) ──────────
@gateId = WKLEJ_ID_BRAMKI_TUTAJ

GET {{baseUrl}}/api/gates/{{gateId}}
Authorization: Bearer {{token}}
Accept: application/json

### ── 6. Edycja bramki ────────────────────────────────────────────────────────
PUT {{baseUrl}}/api/gates/{{gateId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bramka A (zaktualizowana)",
  "type": "Bidirectional"
}

### ── 7. Dodanie zdjęcia z kamery do bramki ──────────────────────────────────
POST {{baseUrl}}/api/gates/{{gateId}}/captures
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "licensePlate": "KR 12345",
  "brand": "Toyota",
  "color": "Red",
  "imagePath": "/images/kr12345.jpg"
}

### ── 8. Pobranie zdjęć z bramki ─────────────────────────────────────────────
GET {{baseUrl}}/api/gates/{{gateId}}/captures
Authorization: Bearer {{token}}
Accept: application/json

### ── 9. Usunięcie zdjęcia (wklej ID capture z odpowiedzi żądania nr 7) ─────
@captureId = WKLEJ_ID_CAPTURE_TUTAJ

DELETE {{baseUrl}}/api/gates/{{gateId}}/captures/{{captureId}}
Authorization: Bearer {{token}}

### ── 10. Test 401 — brak tokenu ─────────────────────────────────────────────
GET {{baseUrl}}/api/gates
Accept: application/json

### ── 11. Test 404 — nieistniejąca bramka ────────────────────────────────────
GET {{baseUrl}}/api/gates/00000000-0000-0000-0000-000000000000/captures
Authorization: Bearer {{token}}
Accept: application/json

### ── 12. Odświeżenie tokenu (wklej refreshToken z logowania) ────────────────
@refreshToken = WKLEJ_REFRESH_TOKEN_TUTAJ

POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "accessToken": "{{token}}",
  "refreshToken": "{{refreshToken}}"
}

### ── 13. Wylogowanie (unieważnienie refresh tokenu) ─────────────────────────
POST {{baseUrl}}/api/auth/revoke
Authorization: Bearer {{token}}
Content-Type: application/json

"{{refreshToken}}"
